{
  "/api/projects/{pid}/entities": {
    "post": {
      "tags": [
        "Сущности"
      ],
      "summary": "POST /api/projects/{pid}/entities",
      "description": "Создаёт сущность с типом и необязательным диапазоном.",
      "parameters": [
        {
          "name": "pid",
          "in": "path",
          "required": true,
          "description": "Идентификатор объекта",
          "schema": {
            "type": "integer"
          },
          "example": 1
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Название сущности",
                  "example": "ENT_комната"
                },
                "type": {
                  "type": "string",
                  "description": "Тип: string, number, time, date, boolean",
                  "example": "string"
                },
                "range_min": {
                  "type": "string",
                  "description": "Нижняя граница диапазона (number, time, date); пустая строка — не задана",
                  "example": ""
                },
                "range_max": {
                  "type": "string",
                  "description": "Верхняя граница диапазона; пустая строка — не задана",
                  "example": ""
                }
              },
              "required": [
                "name"
              ]
            },
            "example": {
              "name": "ENT_комната",
              "type": "string",
              "range_min": "",
              "range_max": ""
            }
          }
        }
      },
      "responses": {
        "201": {
          "description": "Создано",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "integer",
                    "description": "Идентификатор сущности",
                    "example": 2
                  },
                  "name": {
                    "type": "string",
                    "description": "Название",
                    "example": "ENT_комната"
                  },
                  "type": {
                    "type": "string",
                    "description": "Тип: string, number, time, date, boolean",
                    "example": "string"
                  },
                  "range_min": {
                    "type": "string",
                    "description": "Нижняя граница диапазона (number, time, date); пустая строка — не задана",
                    "example": ""
                  },
                  "range_max": {
                    "type": "string",
                    "description": "Верхняя граница диапазона; пустая строка — не задана",
                    "example": ""
                  }
                }
              },
              "example": {
                "id": 2,
                "name": "ENT_комната",
                "type": "string",
                "range_min": "",
                "range_max": ""
              }
            }
          }
        },
        "400": {
          "$ref": "#/components/responses/BadRequestError"
        },
        "404": {
          "$ref": "#/components/responses/NotFoundError"
        },
        "409": {
          "$ref": "#/components/responses/DuplicateError"
        },
        "500": {
          "$ref": "#/components/responses/InternalError"
        }
      }
    }
  }
}
