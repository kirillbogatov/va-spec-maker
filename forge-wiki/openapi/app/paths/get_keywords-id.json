{
  "/api/keywords/{id}": {
    "get": {
      "tags": [
        "Ключевые слова"
      ],
      "summary": "GET /api/keywords/{id}",
      "description": "Возвращает ключевое слово с синонимами и сценариями использования.",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "Идентификатор объекта",
          "schema": {
            "type": "integer"
          },
          "example": 1
        }
      ],
      "responses": {
        "200": {
          "description": "Успех",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "integer",
                    "description": "Идентификатор",
                    "example": 8
                  },
                  "project_id": {
                    "type": "integer",
                    "description": "Проект",
                    "example": 3
                  },
                  "name": {
                    "type": "string",
                    "description": "Код ключевого слова без $",
                    "example": "OFF"
                  },
                  "synonyms": {
                    "type": "array",
                    "description": "Синонимы",
                    "items": {
                      "type": "string"
                    }
                  },
                  "used_by": {
                    "type": "array",
                    "description": "Сценарии, где используется ключевое слово",
                    "items": {
                      "$ref": "#/components/schemas/ScenarioRef"
                    }
                  }
                }
              },
              "example": {
                "id": 8,
                "project_id": 3,
                "name": "OFF",
                "synonyms": [
                  "выключи",
                  "погаси"
                ],
                "used_by": []
              }
            }
          }
        },
        "404": {
          "$ref": "#/components/responses/NotFoundError"
        },
        "500": {
          "$ref": "#/components/responses/InternalError"
        }
      }
    }
  }
}
