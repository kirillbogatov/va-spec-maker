{
  "/api/scenarios/{sid}/prompts/{pid}": {
    "delete": {
      "tags": [
        "Сценарии"
      ],
      "summary": "DELETE /api/scenarios/{sid}/prompts/{pid}",
      "description": "Снимает подключение промпта к сценарию; сам промпт остаётся в проекте.",
      "parameters": [
        {
          "name": "sid",
          "in": "path",
          "required": true,
          "description": "Идентификатор объекта",
          "schema": {
            "type": "integer"
          },
          "example": 1
        },
        {
          "name": "pid",
          "in": "path",
          "required": true,
          "description": "Идентификатор объекта",
          "schema": {
            "type": "integer"
          },
          "example": 1
        }
      ],
      "responses": {
        "204": {
          "description": "Успех, тела ответа нет"
        },
        "404": {
          "$ref": "#/components/responses/NotFoundError"
        },
        "409": {
          "$ref": "#/components/responses/InUseError"
        },
        "500": {
          "$ref": "#/components/responses/InternalError"
        }
      }
    }
  }
}
