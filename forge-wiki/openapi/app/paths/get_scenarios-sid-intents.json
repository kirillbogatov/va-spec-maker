{
  "/api/scenarios/{sid}/intents": {
    "get": {
      "tags": [
        "Сценарии"
      ],
      "summary": "GET /api/scenarios/{sid}/intents",
      "description": "Возвращает интенты, подключённые к сценарию, в порядке подключения.",
      "parameters": [
        {
          "name": "sid",
          "in": "path",
          "required": true,
          "description": "Идентификатор объекта",
          "schema": {
            "type": "integer"
          },
          "example": 1
        }
      ],
      "responses": {
        "200": {
          "description": "Успех",
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer",
                      "description": "Идентификатор интента",
                      "example": 7
                    },
                    "name": {
                      "type": "string",
                      "description": "Название интента",
                      "example": "INT_включить_свет"
                    },
                    "enabled": {
                      "type": "boolean",
                      "description": "Интент включён",
                      "example": true
                    },
                    "phrase_count": {
                      "type": "integer",
                      "description": "Число тренировочных фраз",
                      "example": 5
                    },
                    "hint": {
                      "type": "string",
                      "description": "Краткое описание: комментарий или первая непустая фраза",
                      "example": "Включи свет"
                    },
                    "is_global": {
                      "type": "boolean",
                      "description": "Интент глобальный в этом сценарии",
                      "example": false
                    },
                    "scenarios": {
                      "type": "array",
                      "description": "Сценарии, к которым подключён интент",
                      "items": {
                        "$ref": "#/components/schemas/ScenarioRef"
                      }
                    }
                  }
                }
              },
              "example": [
                {
                  "id": 7,
                  "name": "INT_включить_свет",
                  "enabled": true,
                  "phrase_count": 5,
                  "hint": "Включи свет",
                  "is_global": false,
                  "scenarios": []
                }
              ]
            }
          }
        },
        "500": {
          "$ref": "#/components/responses/InternalError"
        }
      }
    }
  }
}
