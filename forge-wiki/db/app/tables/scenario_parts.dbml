Table scenario_parts {
  id integer [pk]
  scenario_id integer [not null, ref: > scenarios.id, delete: cascade]
  position integer [not null, default: 0]
  name text [not null, default: '']
  description text [not null, default: '']
  layout text [not null, default: '{}']

  Note: 'Вкладка сценария; layout — JSON положения узлов по именам состояний.'
}
