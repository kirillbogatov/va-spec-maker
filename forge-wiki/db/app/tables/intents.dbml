Table intents {
  id integer [pk]
  project_id integer [not null, ref: > projects.id, delete: cascade]
  name text [not null]
  enabled integer [not null, default: 1]
  comment text [not null, default: '']

  indexes {
    (project_id, name) [unique]
  }

  Note: 'Интент проекта. Фразы и паттерны хранятся в дочерних таблицах.'
}
